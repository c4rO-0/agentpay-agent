# Illustrative direct-runtime unit. Replace account, checkout and Node paths.
# This does not configure paid service identity, storage or credentials.
# Follow doc/runbooks/public-provider.md before exposing any routes.
[Unit]
Description=AgentPay Agent Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentpay-provider
Group=agentpay-provider
WorkingDirectory=/opt/agentpay-agent

# Runtime inputs
Environment=NODE_ENV=production
Environment=APP_DIR=/opt/agentpay-agent
Environment=PATH=/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStart=/usr/bin/node /opt/agentpay-agent/src/index.mjs

Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
