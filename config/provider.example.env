# Copy outside the repository, owned by the Provider user, chmod 0600.
# Literal values only: no export statements, shell commands or $VAR expansion.
MARKET_BASE_URL=https://market.example
MARKET_EMAIL=provider@example.com
MARKET_SESSION_TOKEN_FILE=/ABSOLUTE/PRIVATE/market-session.token
SETTLEMENT_BASE_URL=https://settlement.example
AGENT_PROD_SERVICE_ID=random
AGENT_PROD_KIND=random
AGENT_PROD_HOST=127.0.0.1
AGENT_PROD_PORT=6571
AGENT_PUBLIC_BASE_URL=https://provider.example
AGENTPAY_NATIVE_PROVIDER_ENABLED=true
AGENTPAY_NATIVE_PROVIDER_ADMISSION_STATE=pre_admission
AGENT_PROVIDER_BINDING_STATE_FILE=/ABSOLUTE/PRIVATE/binding.json
AGENT_PROVIDER_BINDING_CREDENTIAL_FILE=/ABSOLUTE/PRIVATE/random-control.token
# The guided reference uses the same endpoint credential for paid operations.
AGENT_PROVIDER_CREDENTIAL_FILE=/ABSOLUTE/PRIVATE/random-control.token
AGENT_PROVIDER_DB_HOST=127.0.0.1
AGENT_PROVIDER_DB_PORT=3306
AGENT_PROVIDER_DB_USER=REPLACE_WITH_PROVIDER_DB_USER
AGENT_PROVIDER_DB_PASSWORD=REPLACE_WITH_PROVIDER_DB_PASSWORD
AGENT_PROVIDER_DB_NAME=REPLACE_WITH_PROVIDER_DB_NAME
AGENT_NATIVE_NETWORK=REPLACE_WITH_NETWORK
AGENT_NATIVE_ASSET=REPLACE_WITH_ASSET_ADDRESS
AGENT_NATIVE_SELLER=REPLACE_WITH_PAYOUT_ADDRESS
# Generated by service prepare; do not manually set skillId/offerId/profileHash.
AGENT_PROVIDER_SERVICE_STATE_FILE=/ABSOLUTE/PRIVATE/random-service.json
AGENT_NATIVE_BASE_AMOUNT=0
AGENT_NATIVE_UNIT_PRICE=1
AGENT_NATIVE_MAX_USAGE_UNITS=1
# Rolling Quote validity (seconds); each response still includes validUntil.
AGENT_NATIVE_QUOTE_TTL_SECONDS=600
# For an intentional fixed cutoff, remove TTL and set AGENT_NATIVE_VALID_UNTIL
# to a Unix timestamp in seconds. Fixed cutoffs are never renewed automatically.
